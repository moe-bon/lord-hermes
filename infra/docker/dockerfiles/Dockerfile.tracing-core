FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/apexquant-tracing-core ./python/apexquant-tracing-core
RUN pip install --no-cache-dir ./python/apexquant-tracing-core
EXPOSE 8089
CMD ["uvicorn", "apexquant_tracing_core.app:app", "--host", "0.0.0.0", "--port", "8089"]
