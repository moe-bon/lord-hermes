FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/apexquant-config-validation-core ./python/apexquant-config-validation-core
RUN pip install --no-cache-dir ./python/apexquant-config-validation-core
EXPOSE 8092
CMD ["uvicorn", "apexquant_config_validation_core.app:app", "--host", "0.0.0.0", "--port", "8092"]
