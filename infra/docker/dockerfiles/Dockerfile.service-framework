FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/apexquant-service-framework-core ./python/apexquant-service-framework-core
RUN pip install --no-cache-dir ./python/apexquant-service-framework-core
EXPOSE 8080
CMD ["uvicorn", "apexquant_service_framework_core.app:app", "--host", "0.0.0.0", "--port", "8080"]
