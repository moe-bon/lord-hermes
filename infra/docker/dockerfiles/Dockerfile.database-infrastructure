FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/apexquant-database-infrastructure-core ./python/apexquant-database-infrastructure-core
RUN pip install --no-cache-dir ./python/apexquant-database-infrastructure-core
EXPOSE 8081
CMD ["uvicorn", "apexquant_database_infrastructure_core.app:app", "--host", "0.0.0.0", "--port", "8081"]
