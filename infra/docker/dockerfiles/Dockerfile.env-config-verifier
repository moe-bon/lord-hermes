FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && useradd --create-home --uid 10001 apex \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY python/apexquant-env-config ./python/apexquant-env-config

RUN pip install --no-cache-dir ./python/apexquant-env-config

USER 10001

ENTRYPOINT ["apexquant-env-config"]

CMD ["--help"]