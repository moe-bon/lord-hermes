FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/apexquant-disaster-recovery-core ./python/apexquant-disaster-recovery-core
RUN pip install --no-cache-dir ./python/apexquant-disaster-recovery-core
EXPOSE 8094
CMD ["uvicorn", "apexquant_disaster_recovery_core.app:app", "--host", "0.0.0.0", "--port", "8094"]
