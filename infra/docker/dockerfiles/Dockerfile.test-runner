FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git \
    && useradd --create-home --uid 10001 apex \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY python/apexquant-testing ./python/apexquant-testing
COPY migrations/postgres/testing /migrations/postgres/testing

RUN pip install --no-cache-dir ./python/apexquant-testing

USER 10001

ENTRYPOINT ["apexquant-test-runner"]

CMD ["list-failure-modes"]