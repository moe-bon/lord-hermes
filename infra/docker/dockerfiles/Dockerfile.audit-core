FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/apexquant-audit-core ./python/apexquant-audit-core
RUN pip install --no-cache-dir ./python/apexquant-audit-core
EXPOSE 8087
CMD ["uvicorn", "apexquant_audit_core.app:app", "--host", "0.0.0.0", "--port", "8087"]
