FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/apexquant-feature-flags-core ./python/apexquant-feature-flags-core
RUN pip install --no-cache-dir ./python/apexquant-feature-flags-core
EXPOSE 8091
CMD ["uvicorn", "apexquant_feature_flags_core.app:app", "--host", "0.0.0.0", "--port", "8091"]
