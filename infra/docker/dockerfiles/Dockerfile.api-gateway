FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/apexquant-api-gateway ./python/apexquant-api-gateway
RUN pip install --no-cache-dir ./python/apexquant-api-gateway
EXPOSE 8085
CMD ["uvicorn", "apexquant_api_gateway.app:app", "--host", "0.0.0.0", "--port", "8085"]
