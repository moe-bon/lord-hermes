COMPOSE_PROJECT_NAME=apexquant-ultra

APEX_ENVIRONMENT=local
APEX_TRADING_MODE=DEVELOPMENT
APEX_LIVE_CAPITAL_ALLOWED=false
APEX_FAIL_CLOSED_DEFAULT=true

POSTGRES_DB=apexquant
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex

MINIO_ROOT_USER=apex
MINIO_ROOT_PASSWORD=apexquant-minio

SERVICE_FRAMEWORK_IMAGE=apexquant/service-framework-core
SERVICE_FRAMEWORK_VERSION=0.1.0

REPO_VERIFIER_IMAGE=apexquant/repo-architecture-verifier
REPO_VERIFIER_VERSION=0.2.0

CONTAINER_POLICY_IMAGE=apexquant/container-policy-verifier
CONTAINER_POLICY_VERSION=0.3.0

ENV_CONFIG_IMAGE=apexquant/env-config-verifier
ENV_CONFIG_VERSION=0.4.0


SECRETS_MANAGER_IMAGE=apexquant/secrets-manager
SECRETS_MANAGER_VERSION=0.5.0

APEX_SECRETS_STORE_PATH=infra/security/secrets/local.apexsecrets
APEX_SECRETS_AUDIT_PATH=infra/security/audit/secrets-audit.jsonl

# Provide exactly one of these at runtime.
# Never commit real values.
# APEX_MASTER_KEY=
# APEX_MASTER_PASSPHRASE=

DATABASE_INFRASTRUCTURE_IMAGE=apexquant/database-infrastructure-core
DATABASE_INFRASTRUCTURE_VERSION=0.6.0
APEX_DB_INSTANCE_NAME=apexquant-local

EVENT_BUS_IMAGE=apexquant/event-bus-verifier
EVENT_BUS_VERSION=0.8.0
APEX_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

API_GATEWAY_IMAGE=apexquant/api-gateway
API_GATEWAY_VERSION=0.10.0
APEX_GATEWAY_MAX_BODY_BYTES=10485760
APEX_GATEWAY_REQUEST_TIMEOUT_SECS=5

AUTH_CORE_IMAGE=apexquant/auth-core
AUTH_CORE_VERSION=0.11.0

# Required for Feature 0.11.
# Generate with:
#   ./scripts/auth/generate-token-secret.sh
#   ./scripts/auth/generate-bootstrap-api-key.sh
APEX_AUTH_TOKEN_SECRET=
APEX_AUTH_BOOTSTRAP_API_KEY=


# Bootstrap principal metadata.
APEX_AUTH_BOOTSTRAP_CLIENT_ID=bootstrap-admin
APEX_AUTH_BOOTSTRAP_PERMISSIONS=*

# Gateway auth mode: disabled | permissive | enforced
APEX_GATEWAY_AUTH_MODE=permissive

AUDIT_CORE_IMAGE=apexquant/audit-core
AUDIT_CORE_VERSION=0.13.0

# Optional but required in production.
APEX_AUDIT_INGEST_SHARED_SECRET=

LOGGING_CORE_IMAGE=apexquant/logging-core
LOGGING_CORE_VERSION=0.14.0

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=apexquant-grafana

TRACING_CORE_IMAGE=apexquant/tracing-core
TRACING_CORE_VERSION=0.16.0

TEST_RUNNER_IMAGE=apexquant/test-runner
TEST_RUNNER_VERSION=0.19.0

MIGRATION_CORE_IMAGE=apexquant/migration-core
MIGRATION_CORE_VERSION=0.20.0

SERVICE_VERSION_CORE_IMAGE=apexquant/service-version-core
SERVICE_VERSION_CORE_VERSION=0.21.0

CONFIG_VALIDATION_CORE_IMAGE=apexquant/config-validation-core
CONFIG_VALIDATION_CORE_VERSION=0.23.0

BACKUP_RECOVERY_CORE_IMAGE=apexquant/backup-recovery-core
BACKUP_RECOVERY_CORE_VERSION=0.24.0

DISASTER_RECOVERY_CORE_IMAGE=apexquant/disaster-recovery-core
DISASTER_RECOVERY_CORE_VERSION=0.25.0